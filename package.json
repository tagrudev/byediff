{
  "name": "byediff",
  "version": "0.1.0",
  "description": "Local GitHub-style review tool for AI-generated git working-tree diffs",
  "type": "module",
  "bin": {
    "byediff": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:ui": "vite build",
    "build:server": "tsup src/cli.ts --format esm --target node20 --clean=false --out-dir dist",
    "build": "npm run build:ui && npm run build:server",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^5.1.0",
    "open": "^10.1.0",
    "parse-diff": "^0.11.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^1.24.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
